FROM debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
ENV DEBIAN_FRONTEND=noninteractive
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
 && chmod 755 /usr/sbin/policy-rc.d \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3-minimal \
 && curl --fail --silent --show-error --location https://packages.sury.org/debsuryorg-archive-keyring.deb -o /tmp/sury-keyring.deb \
 && echo '7511384559c9ddf1d5ce5f60be429ae9d4e7d01d9480d6f1b7a30c0810cf8b60  /tmp/sury-keyring.deb' | sha256sum -c - \
 && dpkg -i /tmp/sury-keyring.deb \
 && printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ trixie main\n' > /etc/apt/sources.list.d/php.list \
 && apt-get update \
 && rm -rf /var/lib/apt/lists/* /tmp/sury-keyring.deb
COPY collect.py /collect.py
ENTRYPOINT ["python3", "/collect.py"]
